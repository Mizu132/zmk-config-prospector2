/ {
    chosen {
        zmk,input-listener = &touch_listener;
    };
};

&i2c0 {
    status = "okay";

    touch_sensor: cst816s@15 {
        compatible = "hynitron,cst816s";
        reg = <0x15>;
        status = "okay";
        /* INVERTED LOGIC: Switched to Active High with a pull-down resistor to clear the input freeze */
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; /* D0 */
        rst-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;                 /* D1 */
    };
};

/ {
    touch_listener: touch_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&touch_sensor>;
    };
};
